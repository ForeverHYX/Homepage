# /daily harvesting is blocked at the nginx layer with the JS cookie gate.
# A generous 443 NEW-connection cap (500/s, burst 250) stays in before.rules
# so a distributed connect-flood cannot spend the whole egress pipe on TLS
# handshake bytes. Dropped SYNs cost zero egress; raise or remove the pair
# here and in /etc/ufw/before.rules + before6.rules when the flood ends.
-A ufw-before-input -p tcp --dport 443 -m conntrack --ctstate NEW -m limit --limit 500/second --limit-burst 250 -j ACCEPT
-A ufw-before-input -p tcp --dport 443 -m conntrack --ctstate NEW -j DROP
-A ufw6-before-input -p tcp --dport 443 -m conntrack --ctstate NEW -m limit --limit 500/second --limit-burst 250 -j ACCEPT
-A ufw6-before-input -p tcp --dport 443 -m conntrack --ctstate NEW -j DROP
